# OpenRouter — Model Configuration
# Primary: Qwen3 32B (for general chat - fast, cost-effective, knowledge cutoff: March 2025)
# Visual Planner: Claude Opus 4.8 (detailed animation storyboards, reasoning)
# Visual Generator: Claude Sonnet 4.6 (GSAP/Canvas animation code generation)
# Fallback: Google Gemini 2.5 Flash (if primary fails)
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=qwen/qwen-3-32b-instruct
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_VISUAL_PLANNER_MODEL=anthropic/claude-opus-4.8
OPENROUTER_VISUAL_GENERATOR_MODEL=anthropic/claude-sonnet-4.6

# Sarvam narration
SARVAM_API_KEY=replace-with-your-sarvam-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_VOICE=shubh
SARVAM_DEFAULT_LANGUAGE=hi-IN
SARVAM_SAMPLE_RATE=22050
SARVAM_AUDIO_FORMAT=wav

# Runtime
FRONTEND_ORIGIN=http://localhost:3000
LLM_TIMEOUT_SECONDS=120
VISUAL_MAX_CONCURRENT=5
USD_TO_INR=83.5
